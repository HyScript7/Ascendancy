root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Matches the Palantir formatter used by Spotless (./gradlew spotlessApply).
[*.java]
indent_size = 4
max_line_length = 120

[*.{gradle,gradle.kts}]
indent_size = 4

[*.{json,mcmeta,yml,yaml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Generated / vendored — leave alone.
[{gradlew,gradlew.bat,gradle/wrapper/**}]
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[docs/.obsidian/**]
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
